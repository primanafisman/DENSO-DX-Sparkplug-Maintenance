# Public development configuration only. Never add server keys or passwords.
# Empty means same-origin /api/v1. Vite proxies to the local Node API in development.
VITE_API_BASE_URL=

# Optional development HTTPS file paths; never put private key contents here.
# Without an explicit pair, Vite tries ../certs/denso-*.pem then Backend runtime TLS.
SPM_DEV_HTTPS_CERT=
SPM_DEV_HTTPS_KEY=
