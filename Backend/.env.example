# Generate unique random secrets locally. Never put real secrets in this file.
JWT_SECRET=
CV_INTERNAL_TOKEN=
NODE_ENV=development
HOST=127.0.0.1
PORT=8100
CV_URL=http://127.0.0.1:8101
CORS_ORIGINS=http://127.0.0.1:8100
SPM_LAN_ENABLED=1
# Optional trusted local HTTPS for live phone camera guides; setup-camera.cmd creates keys.
SPM_HTTPS_ENABLED=0
SPM_HTTPS_PORT=8443
SPM_TLS_CERT=runtime/tls/server-cert.pem
SPM_TLS_KEY=runtime/tls/server-key.pem
SPM_TLS_CA=runtime/tls/ca-cert.pem
RUNTIME_DIR=runtime
DB_DIALECT=sqlite
# SQL Server/MySQL: configure reviewed database schema and credentials separately.
DB_NAME=DX_SPM
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
# Relative to this workspace, bundled with the transfer package; no auto-download.
OCR_MODEL_DIR=cv_engine/models/ocr
